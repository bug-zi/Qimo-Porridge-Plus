[32m+[m[32mdef get_active_agent_job(course_id: str, job_type: str) -> dict[str, Any] | None:[m
[32m+[m[32m    """Return the newest active job so a refreshed client can resume polling it."""[m
[32m+[m[32m    initialize_agent_database()[m
[32m+[m[32m    with _connection() as connection:[m
