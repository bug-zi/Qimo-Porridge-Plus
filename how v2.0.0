[32m+[m[32m            "SELECT id FROM agent_jobs WHERE course_id = ? AND job_type = ? "[m
[32m+[m[32m            "AND status IN ('queued', 'running') ORDER BY created_at DESC LIMIT 1",[m
[32m+[m[32m            (course_id, job_type),[m
[32m+[m[32m        ).fetchone()[m
[32m+[m[32m    return get_agent_job(str(row["id"])) if row is not None else None[m
